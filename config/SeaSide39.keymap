#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* レイヤー定義 */
#define DEFAULT 0
#define MOUSE   1
#define NUM_SYM 2
#define CONFIG  3
#define SCROLL  4

/ {
    /* カスタム挙動の定義 */
    behaviors {
        // 中井さん仕様の300msタップ
        mt_n: mod_tap_nakai {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* LAYER 0: DEFAULT (39キー凝縮版) */
        default_layer {
            bindings = <
    &kp Q      &kp W      &kp E      &kp R      &kp T                         &kp Y      &kp U      &kp I      &kp O      &kp P
    &kp A      &kp S      &kp D      &kp F      &kp G                         &kp H      &kp J      &kp K      &kp L      &mt LSHIFT ENTER
    &kp Z      &kp X      &kp C      &kp V      &kp B                         &kp N      &mkp MB1   &mkp MB3   &mkp MB2   &kp FSLH
                &kp LSHIFT &kp LWIN   &kp LALT                                                                   &kp RO
                &mt LSHIFT LANG2 &lt MOUSE SPACE &lt CONFIG LANG1        &kp BSPC &lt NUM_SYM ENTER &none
            >;
        };

        /* LAYER 1: MOUSE (オートマウスで自動移動) */
        mouse_layer {
            bindings = <
    &kp F1     &kp F2     &kp UP     &kp F4     &kp F5                        &kp F6     &kp F7     &kp F8     &kp F9     &kp F10
    &none      &kp LEFT   &kp DOWN   &kp RIGHT  &kp DEL                       &none      &mkp MB1   &mkp MB3   &mkp MB2   &mo SCROLL
    &none      &none      &none      &none      &none                         &none      &kp LEFT   &kp DOWN   &kp RIGHT  &kp F12
                &none      &none      &none                                                                      &none
                &none      &none      &none                               &none      &none      &none
            >;
        };

        /* LAYER 2: NUM & SYMBOL */
        num_sym_layer {
            bindings = <
    &kp N7     &kp N8     &kp N9     &none      &none                         &none      &none      &kp LBKT   &kp RBKT   &none
    &kp N4     &kp N5     &kp N6     &none      &none                         &none      &none      &kp MINUS  &kp EQUAL  &none
    &kp N1     &kp N2     &kp N3     &none      &none                         &none      &none      &none      &none      &none
                &kp N0     &none      &none                                                                      &none
                &none      &none      &none                               &kp DEL    &none      &none
            >;
        };

        /* LAYER 3: CONFIG */
        config_layer {
            bindings = <
    &bt BT_CLR &none      &none      &none      &none                         &none      &none      &none      &none      &none
    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none               &none      &none      &none      &none      &none
    &none      &none      &none      &none      &none                         &bootloader &none     &none      &none      &none
                &none      &none      &none                                                                      &none
                &none      &none      &none                               &none      &none      &none
            >;
        };

        /* LAYER 4: SCROLL */
        scroll_layer {
            bindings = <
    &trans     &trans     &trans     &trans     &trans                        &trans     &trans     &trans     &trans     &trans
    &trans     &trans     &trans     &trans     &trans                        &trans     &trans     &trans     &trans     &trans
    &trans     &trans     &trans     &trans     &trans                        &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans                                                                     &trans
                &trans     &trans     &trans                              &trans     &trans     &trans
            >;
        };
    };
};

/* 参照（&）を使った設定はルートノードの外に書く */
&trackball {
    input-processors = 
        <&zi_temp_layer MOUSE 600>, 
        <&zi_scroll_layer SCROLL>;
};
